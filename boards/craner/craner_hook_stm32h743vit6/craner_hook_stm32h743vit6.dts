/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Craner AI Safety Hook (tower-crane hook safety controller)
 * MCU : STM32H743VIT6 on the H743 core board with 4x RS485
 *       (board schematic in docs/), HSE 25 MHz, LSE 32.768 kHz
 *
 * Pin map is taken from crane_ai_satefy_hook.ioc of the original
 * STM32CubeIDE firmware:
 *   uart5  (PB6/PB5,  115200) : shell / console / printf
 *   usart1 (PA9/PA10, 115200) : 4G / cloud transparent module (usr.cn)
 *   usart2 (PD5/PD6,  9600)   : spare (initialised but unused in the old fw)
 *   usart3 (PD8/PD9,  115200) : spare (no GPS module on this product)
 *   usart6 (PC6/PC7,  9600)   : RS485 - BMS Modbus RTU master
 *   uart7  (PE8/PE7,  9600)   : RS485 - sound & light alarm module master
 *   uart8  (PE1/PE0,  9600)   : RS485 - host controller Modbus RTU slave
 *
 * RS485 ports have auto-direction transceivers on this board, so no
 * de-gpios property is required.
 */

/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	model = "Craner AI Safety Hook STM32H743VIT6";
	compatible = "craner,craner-hook-stm32h743vit6";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart5;
		zephyr,shell-uart = &uart5;
		zephyr,dtcm = &dtcm;
		/* Persistent device parameters (Zephyr Settings/ZMS) live on the
		 * on-board QSPI flash, next to the persistent Modbus registers.
		 */
		zephyr,settings-partition = &app_storage_partition;
	};

	aliases {
		watchdog0 = &iwdg;
		/* LEDs */
		heartbeat-led = &heartbeat_led;
		pwr-led = &pwr_led;
		/* Hook actuator / power outputs */
		alarm-power-en = &alarm_power_en;
		power-3v = &power_3v;
		power-5v = &power_5v;
		modem-power = &modem_power;
		modem-reset = &modem_reset;
		modem-reload = &modem_reload;
	};

	gpio_outputs {
		compatible = "gpio-leds";

		/* PD10: error/heart LED driven by the LED animation engine. */
		heartbeat_led: heartbeat-led {
			gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
			label = "HEART_LED";
		};

		/* PB3: mirrors the Modbus flash-light command register (driven by
		 * app/hook_alarm / app/hook_heartbeat, not the supply enable).
		 */
		pwr_led: pwr-led {
			gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>;
			label = "PWD_LED";
		};

		/* PE5: supply enable of the sound & light alarm ("警报灯供电使能"
		 * on the schematic, FLASH_LIGHT_POWER_EN in the .ioc). The host
		 * heartbeat supervision cuts it after 60 s of silence.
		 */
		alarm_power_en: alarm-power-en {
			gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
			label = "ALARM_POWER_EN";
		};

		/* Load switches (same pinout as the craner general board). */
		power_3v: power-3v {
			gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;
			label = "POWER_3V";
		};

		power_5v: power-5v {
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			label = "POWER_5V";
		};

		/* PA15: 4G module 3.3 V rail. */
		modem_power: modem-power {
			gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
			label = "POWER_4G_3V3";
		};

		/* PD14 / PD15: 4G module reset and reload (active high). */
		modem_reset: modem-reset {
			gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
			label = "RESET_4G";
		};

		modem_reload: modem-reload {
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
			label = "RELOAD_4G";
		};
	};

	/* SD card (offline event log storage), FATFS mount point /SD:. */
	fstab {
		compatible = "zephyr,fstab";

		sd_mp: sd_mp {
			compatible = "zephyr,fstab,fatfs";
			disk-access;
			mount-point = "/SD:";
		};
	};
};

/*
 * SDMMC1 (PC8-PC12 + PD2): same pinout as the craner general H743 PCB and the
 * AI safety car, the SD card seat has no card-detect GPIO.
 *
 * Clock: PLL1Q is 48 MHz (960 MHz VCO / div-q 20), the same domain clock the
 * car board feeds to SDMMC, so the card uses the same clk-div 2 setting.
 */
&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	disk-name = "SD";
	bus-width = <1>;
	clk-div = <2>;
	status = "okay";
};

/*
 * MCUboot layout (2 MiB internal flash, swap-using-move):
 *   0x08000000..0x0801FFFF : MCUboot (flash bank 1)
 *   0x08020000..0x080FFFFF : slot0 - running image (896 KiB, flash bank 1)
 *   0x08100000..0x081BFFFF : slot1 - update image  (768 KiB, flash bank 2)
 *   0x081C0000..0x081DFFFF : coredump partition
 *   0x081E0000..0x081FFFFF : app storage (reserved)
 *
 * slot1 is deliberately aligned to the flash bank 2 boundary: the running
 * application executes from bank 1, so an application-side OTA download can
 * erase/program slot1 in bank 2 without stalling the core (STM32H7 read
 * while write restriction). This is the same layout as craner_ai_safety_car.
 *
 * Everything that has to be written at runtime (persistent registers today,
 * device parameters / offline logs later) lives on the on-board W25Q64 QSPI
 * NOR flash, so the internal flash keeps its OTA layout untouched.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00020000>;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x00020000 0x000e0000>;
		};

		slot1_partition: partition@100000 {
			label = "image-1";
			reg = <0x00100000 0x000c0000>;
		};

		app_storage_partition: partition@1c0000 {
			label = "app-storage";
			reg = <0x001c0000 0x00040000>;
		};
	};
};

/*
 * On-board W25Q64JVSSIQ (8 MiB QSPI NOR, U12 on the core board schematic:
 * PB10 NCS, PB2 CLK, PD11 IO0, PD12 IO1, PD13 IO2, PE2 IO3).
 *
 * Partitioning follows craner_ai_safety_car:
 *   0x000000..0x01FFFF : device parameter store (Zephyr Settings/ZMS)
 *   0x020000..0x021FFF : persistent Modbus registers (modbus_data_model),
 *                        two 4 KiB banks, i.e. one NOR sector per bank
 *   0x022000..0x7FFFFF : reserve (offline logs / future use)
 */
&quadspi {
	pinctrl-0 = <&quadspi_bk1_io0_pd11
		     &quadspi_bk1_io1_pd12
		     &quadspi_bk1_io2_pe2
		     &quadspi_bk1_io3_pd13
		     &quadspi_bk1_ncs_pb10
		     &quadspi_clk_pb2>;
	pinctrl-names = "default";
	status = "disabled";

	w25q64: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		/* st,stm32-qspi-nor size property is in BITS: 8 MiB = 64 Mbit. */
		size = <DT_SIZE_M(64)>;
		qspi-max-frequency = <40000000>;
		spi-bus-width = <4>;
		writeoc = "PP_1_1_4";
		status = "disabled";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			param_store_partition: partition@0 {
				label = "param-store";
				reg = <0x00000000 0x00020000>;
			};

			modbus_store_partition: partition@20000 {
				label = "modbus-store";
				reg = <0x00020000 0x00002000>;
			};

			reserve_partition: partition@22000 {
				label = "reserve";
				reg = <0x00022000 0x007de000>;
			};
		};
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_lse {
	status = "okay";
};

/*
 * Clock tree copied from the old CubeMX firmware (and from the upstream
 * Zephyr nucleo_h743zi board, which also runs a H743 at 480 MHz):
 *
 *   HSE 25 MHz / div-m 5 = 5 MHz VCO input
 *   x mul-n 192          = 960 MHz VCO (wide range)
 *   / div-p 2            = 480 MHz SYSCLK (CPU, VOS0)
 *   / hpre 2             = 240 MHz HCLK/AXI
 *   / d?ppre 2           = 120 MHz APB1/2/3/4
 *
 * The Zephyr STM32H7 clock driver selects VOS0 before programming the PLL
 * and re-programs the flash wait states for the new HCLK, so only the PLL
 * and prescaler values below have to be kept consistent.
 */
&pll {
	div-m = <5>;
	mul-n = <192>;
	div-p = <2>;
	div-q = <20>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

&rng {
	status = "okay";
};

/* Internal RTC on LSE. Alarm B wakes the MCU from STANDBY. */
&rtc {
	clocks = <&rcc STM32_CLOCK(APB4, 16)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&bbram {
	status = "okay";
};

&iwdg {
	status = "okay";
};

&uart5 {
	pinctrl-0 = <&uart5_tx_pb6 &uart5_rx_pb5>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* 4G / cloud transparent module. */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	/* USART1 RX/TX requests are 41/42 on STM32H7. */
	dmas = <&dmamux1 0 42 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 1 41 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
	status = "okay";
};

/* DMA controller feeding USART1 async RX/TX. */
&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

/* Spare port (initialised but unused by the original firmware). */
&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

/* Spare port: the GPS module was removed from this product, the RTC is
 * calibrated over Modbus RTU / MQTT instead.
 */
&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "disabled";
};

/* RS485 - BMS Modbus RTU master. */
&usart6 {
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";

	rs485_usart6: rs485-usart6 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};

/* RS485 - sound & light alarm module Modbus RTU master. */
&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";

	rs485_uart7: rs485-uart7 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};

/* RS485 - host (上位机) Modbus RTU slave. */
&uart8 {
	pinctrl-0 = <&uart8_tx_pe1 &uart8_rx_pe0>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";

	rs485_uart8: rs485-uart8 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};
