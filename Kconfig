source "Kconfig.zephyr"

rsource "module/system_health_service/Kconfig"
rsource "module/time_manager_service/Kconfig"
rsource "module/ota_manager_service/Kconfig"
rsource "module/fault_dump_service/Kconfig"
rsource "module/modbus_data_model/Kconfig"
rsource "module/device_param_server/Kconfig"
rsource "module/device_identity_service/Kconfig"
rsource "component/offline_log_service/Kconfig"
rsource "app/log_manage_app/Kconfig"

menu "Craner AI safety hook application"

config HOOK_MODBUS_SLAVE_ID
	int "Modbus RTU slave address on the host RS485 bus (uart8)"
	default 1
	range 1 247
	help
	  The hook controller is a Modbus RTU slave for the crane host
	  controller (上位机). The old firmware used FORWARD_SLAVE_ADDR = 1.

config HOOK_4G_ENABLE
	bool "4G / cloud channel (usr.cn transparent module on usart1)"
	default y
	help
	  Enables the usr.cn transparent bridge handling, the craner#AT command
	  surface and the binary 0xA5 cloud protocol.

config HOOK_HARD_STANDBY_ENABLE
	bool "Allow STM32 hard standby (RTC alarm B wakeup)"
	default y
	help
	  When enabled, the RTC power schedule may put the MCU into STM32
	  STANDBY and wake it up with RTC alarm B at the configured power-on
	  time. Requires a trusted RTC time (host Modbus RTU or cloud
	  calibration).

config HOOK_HOST_HEARTBEAT_ENABLE
	bool "Host heartbeat supervision (alarm-light supply)"
	default y
	help
	  Watches the host heartbeat counter (holding register 0x04, written by
	  the crane host controller or the cloud over MQTT). Silence >10 s
	  clears the alarm outputs; silence >60 s cuts the alarm-light supply
	  (PE5, FLASH_LIGHT_POWER_EN in the .ioc) and sets
	  ERR_HEARTBEAT_TIMEOUT. There is no relay on this board, the pin is the
	  supply enable of the sound & light alarm.

config HOOK_ALARM_MODULE_ENABLE
	bool "External sound & light alarm module on uart7"
	default y

config HOOK_BMS_ENABLE
	bool "Battery management system (BMS) polling on usart6"
	default y

config HOOK_HEARTBEAT_SILENCE_MS
	int "Host heartbeat silence timeout in milliseconds"
	default 10000
	range 1000 600000
	help
	  After this silence the LED/buzzer commands are cleared.

config HOOK_HEARTBEAT_TIMEOUT_MS
	int "Host heartbeat power-off timeout in milliseconds"
	default 60000
	range 1000 3600000
	help
	  After this silence the alarm-light supply (FLASH_LIGHT_POWER_EN) is
	  turned off and ERR_HEARTBEAT_TIMEOUT is set in the error code register.

config HOOK_LINK_TIMEOUT_MS
	int "Host heartbeat link timeout for the 4G quality statistics (ms)"
	default 20000
	range 500 60000
	help
	  The crane host controller writes the heartbeat counter once per second.
	  A gap between two received heartbeats longer than this value counts as
	  one timeout in the link quality statistics (offline log category "4g",
	  the "hook link" shell command and the cloud command craner#AT+LINK). The timeout is
	  counted once per outage, when the heartbeat comes back, so a long
	  outage produces one log line instead of one per period.

config HOOK_LOW_BATTERY_THRESHOLD
	int "Low battery warning threshold"
	default 2000
	range 0 10000
	help
	  Battery level register value below which the work mode becomes
	  MODE_LOW_BATTERY (2).

config HOOK_DEFAULT_ALARM_VOLUME
	int "Default sound & light module volume"
	default 30
	range 0 31

config HOOK_POWER_ON_TIME_HHMM
	int "Default daily power-on time (Beijing, high byte hour / low byte minute)"
	default 1536
	range 0 65535
	help
	  0x0600 = 06:00 (same default as the old firmware).

config HOOK_POWER_OFF_TIME_HHMM
	int "Default daily power-off time (Beijing, high byte hour / low byte minute)"
	default 5376
	range 0 65535
	help
	  0x1500 = 21:00 (same default as the old firmware).

config HOOK_OTA_ENABLE
	bool "HTTP OTA into the MCUboot secondary slot"
	default y
	select IMG_MANAGER
	help
	  Let the cloud trigger "craner#AT+OTADL=<url>": the 4G module switches
	  to HTTPD, downloads the image itself, the controller streams it into
	  the MCUboot slot1 partition and verifies it. "craner#AT+OTATEST" then
	  arms a test upgrade (boot_request_upgrade); MCUboot validates the
	  signature, swaps the slots and rolls back unless the new image is
	  confirmed ("craner#AT+OTACONFIRM").

config HOOK_OTA_REBOOT_DELAY_MS
	int "Delay between arming the test upgrade and rebooting in milliseconds"
	default 2000
	range 0 60000
	depends on HOOK_OTA_ENABLE
	help
	  Time for the "craner#OK" of AT+OTATEST (and the offline log entry) to
	  get out before the device resets into the MCUboot test image.


endmenu
